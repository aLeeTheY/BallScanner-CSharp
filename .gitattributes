# =================================================================
# .gitattributes — line endings & binary detection
# =================================================================

# ! --- 1. Default | For all text files
# ! ------------------------------------
# Windows .NET project → CRLF by default. Если поставить LF, то Visual
# Studio при каждом сохранении будет возвращать CRLF, и git будет
# показывать ложные diff'ы.
* text=auto eol=crlf

# ! --- 2. Windows scripts — CRLF
# ! ------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ! --- 3. Unix scripts — LF (если появятся)
# ! ----------------------------------------
*.sh text eol=lf

# ! --- 4. Project files — text, но при конфликтах лучше binary
# ! ------------------------------------------------------------
*.sln text eol=crlf
*.csproj text eol=crlf
*.vbproj text eol=crlf
*.fsproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

*.cs text eol=crlf
*.xaml text eol=crlf
*.config text eol=crlf
*.manifest text eol=crlf
*.resx text eol=crlf
*.settings text eol=crlf
*.xsd text eol=crlf

# ! --- 5. Icons & Images
# ! ---------------------
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.webp binary

*.svg text eol=crlf

# ! --- 6. Fonts
# ! ------------
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# ! --- 7. Signing keys & native binaries
# ! --------------------------------------
*.pfx binary
*.snk binary
*.dll binary
*.exe binary
*.pdb binary

# ! --- 8. SQLite database
# ! ----------------------
*.sqlite3 binary
*.db binary
*.db3 binary

# ! --- 9. Archives
# ! ---------------
*.zip binary
*.rar binary
*.7z binary
*.tar binary
*.gz binary

# ! --- 10. Docs
# ! ------------
*.pdf binary

# ! --- 11. GitHub Linguist settings
# ! --------------------------------
# Если хочешь, чтобы какие-то папки не считались в статистике языков
# (например, сгенерированные сторонние стили), раскомментируй:
# aLeeTheY.Controls/Styles/** linguist-vendored