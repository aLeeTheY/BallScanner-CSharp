<UserControl x:Class="BallScanner.MVVM.Views.Add.RegistrationV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:aleethey="clr-namespace:aLeeTheY.Controls;assembly=aLeeTheY.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="400" 
             d:DesignWidth="550">

    <Border Background="{StaticResource Brush_Surface_Overlay_01dp}">
        <DockPanel LastChildFill="False"
                   Margin="10">

            <StackPanel Orientation="Vertical"
                        DockPanel.Dock="Top">

                <aleethey:BlockHeader Text="{DynamicResource LangRes_RegistrationWindow_BlockLabel}"
                                  TextAlignment="Center"
                                  DockPanel.Dock="Top" />

                <Grid Height="59"
                      Margin="0,7,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <aleethey:LabelTextBox Grid.Column="0"
                                       LabelText="{DynamicResource LangRes_RegistrationWindow_RequiredSurnameLabel}"
                                       Text="{Binding Surname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <aleethey:LabelTextBox Grid.Column="2"
                                       LabelText="{DynamicResource LangRes_RegistrationWindow_RequiredNameLabel}"
                                       Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <aleethey:LabelTextBox Grid.Column="4"
                                       LabelText="{DynamicResource LangRes_RegistrationWindow_LastnameLabel}"
                                       Text="{Binding Lastname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

                <Grid Height="59"
                      Margin="0,7,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <aleethey:LabelTextBox Grid.Column="0"
                                       LabelText="{DynamicResource LangRes_RegistrationWindow_RequiredLoginLabel}"
                                       Text="{Binding Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <aleethey:LabelTextBox Grid.Column="2"
                                       LabelText="{DynamicResource LangRes_RegistrationWindow_RequiredSmenaNumberLabel}"
                                       Text="{Binding Smena_Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

                <Grid Height="59"
                      Margin="0,7,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <aleethey:LabelTextBox Grid.Column="0"
                                       LabelText="{DynamicResource LangRes_RegistrationWindow_RequiredPasswordLabel}"
                                       Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <aleethey:LabelTextBox Grid.Column="2"
                                       LabelText="{DynamicResource LangRes_RegistrationWindow_RequiredPasswordRepeatLabel}"
                                       Text="{Binding Password_Check, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>
            </StackPanel>

            <Button DockPanel.Dock="Bottom"
                    Height="29"
                    Margin="0,10,0,0"
                    Content="{DynamicResource LangRes_RegistrationWindow_AddBtn}"
                    Command="{Binding AddUser_Command}" />

            <StackPanel DockPanel.Dock="Bottom"
                        HorizontalAlignment="Center"
                        Orientation="Vertical">

                <TextBlock FontSize="14"
                           Foreground="{StaticResource Brush_OnBackground_OnSurface_Medium}"
                           Text="{DynamicResource LangRes_RegistrationWindow_HintText__Part_1}"
                           TextAlignment="Center" />
                <TextBlock FontSize="14"
                           Foreground="{StaticResource Brush_OnBackground_OnSurface_Medium}"
                           Text="{DynamicResource LangRes_RegistrationWindow_HintText__Part_2}"
                           TextAlignment="Center" />
                
            </StackPanel>                    

        </DockPanel>
    </Border>
</UserControl>
