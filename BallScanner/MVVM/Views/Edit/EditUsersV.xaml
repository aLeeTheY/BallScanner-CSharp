<UserControl x:Class="BallScanner.MVVM.Views.Edit.EditUsersV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:aleethey="clr-namespace:aLeeTheY.Controls;assembly=aLeeTheY.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    
    <Border Background="{StaticResource Brush_Surface_Overlay_01dp}">
        <DockPanel LastChildFill="False"
                   Margin="10">

            <aleethey:BlockHeader Text="{Binding Title_Text, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                              TextAlignment="Center"
                              DockPanel.Dock="Top" />

            <Grid Height="59"
                  Margin="0,7,0,0"
                  DockPanel.Dock="Top">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <aleethey:LabelTextBox Grid.Column="0"
                                   LabelText="{DynamicResource LangRes_EditUsersWindow_SurnameLabel}"
                                   Text="{Binding Surname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <aleethey:LabelTextBox Grid.Column="2"
                                   LabelText="{DynamicResource LangRes_EditUsersWindow_NameLabel}"
                                   Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <aleethey:LabelTextBox Grid.Column="4"
                                   LabelText="{DynamicResource LangRes_EditUsersWindow_LastnameLabel}"
                                   Text="{Binding Lastname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </Grid>

            <Grid Height="59"
                  Margin="0,7,0,0"
                  DockPanel.Dock="Top">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <aleethey:LabelTextBox Grid.Column="0"
                                   LabelText="{DynamicResource LangRes_EditUsersWindow_LoginLabel}"
                                   Text="{Binding Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <aleethey:LabelTextBox Grid.Column="2"
                                   LabelText="{DynamicResource LangRes_EditUsersWindow_SmenaNumberLabel}"
                                   Text="{Binding Smena_Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </Grid>

            <Grid Height="Auto"
                  Margin="0,7,0,0"
                  DockPanel.Dock="Top">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <aleethey:LabelComboBox Height="59"
                                    Grid.Column="0"
                                    LabelText="{DynamicResource LangRes_EditUsersWindow_AccessLevelLabel}"
                                    SelectedIndex="{Binding Access_Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="{DynamicResource LangRes_EditUsersWindow_AccessLevel_User}" />
                    <ComboBoxItem Content="{DynamicResource LangRes_EditUsersWindow_AccessLevel_Admin}" />
                </aleethey:LabelComboBox>

                <aleethey:LabelComboBox Height="59"
                                    Grid.Column="2"
                                    LabelText="{DynamicResource LangRes_EditUsersWindow_AccountStatusLabel}"
                                    SelectedIndex="{Binding Is_Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="{DynamicResource LangRes_EditUsersWindow_AccountStatus_Inactive}" />
                    <ComboBoxItem Content="{DynamicResource LangRes_EditUsersWindow_AccountStatus_Active}" />
                </aleethey:LabelComboBox>

            </Grid>

            <aleethey:BlockHeader Text="{DynamicResource LangRes_EditUsersWindow_ChangePasswordBlockLabel}"
                              TextAlignment="Center"
                              DockPanel.Dock="Top"
                              Margin="0,21,0,0" />

            <aleethey:LabelTextBox Height="41"
                               Margin="0,7,0,0"
                               Name="NewPassword"
                               DockPanel.Dock="Top"
                               LabelText="{DynamicResource LangRes_EditUsersWindow_NewPasswordLabel}"
                               Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource Style_Inside}" />

            <aleethey:LabelTextBox Height="41"
                               Margin="0,7,0,0"
                               Name="NewPasswordRepeat"
                               DockPanel.Dock="Top"
                               LabelText="{DynamicResource LangRes_EditUsersWindow_NewPasswordRepeatLabel}"
                               Text="{Binding NewPassword_Check, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource Style_Inside}" />

            <Grid DockPanel.Dock="Bottom"
                  Height="29">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Name="ChangePasswordButton"
                        Command="{Binding ChangePasswordCommand}"
                        Visibility="Visible"
                        IsEnabled="True"
                        Content="{DynamicResource LangRes_EditUsersWindow_ChangePasswordBtn}" />
                
                <Button Grid.Column="2"
                        Name="DeleteButton"
                        Command="{Binding DeleteReportCommand}"
                        Visibility="Visible"
                        IsEnabled="True"
                        Content="{DynamicResource LangRes_EditUsersWindow_DeleteAccountBtn}" />

            </Grid>
        </DockPanel>
    </Border>
</UserControl>
