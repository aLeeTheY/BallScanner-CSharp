<UserControl x:Class="BallScanner.MVVM.Views.Main.AccountManagmentV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:aleethey="clr-namespace:aLeeTheY.Controls;assembly=aLeeTheY.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800"
             Name="Root">

    <Border CornerRadius="10,0,0,0"
            Background="{DynamicResource Brush_Surface_Overlay_08dp}">

        <!-- Content -->
        <DockPanel Margin="10"
                   LastChildFill="True">

            <StackPanel DockPanel.Dock="Top"
                        Orientation="Vertical">

                <aleethey:BlockHeader Text="{DynamicResource LangRes_AccountManagementPage_SearchBlockLabel}" />

                <Grid Margin="0,7,0,0"
                      Height="29">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.25*"
                                          MinWidth="150"
                                          MaxWidth="200" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="0.25*"
                                          MinWidth="150"
                                          MaxWidth="200" />
                    </Grid.ColumnDefinitions>
                    <!--<ColumnDefinition Width="7" />
                        <ColumnDefinition Width="0.25*"
                                          MinWidth="150"-->

                    <ComboBox SelectedIndex="{Binding Selected_Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="{DynamicResource LangRes_AccountManagementPage_SearchCriteria_Login}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_AccountManagementPage_SearchCriteria_Surname}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_AccountManagementPage_SearchCriteria_Name}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_AccountManagementPage_SearchCriteria_Lastname}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_AccountManagementPage_SearchCriteria_SmenaNumber}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_AccountManagementPage_SearchCriteria_AccessLevel}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_AccountManagementPage_SearchCriteria_AccountStatus}" />
                    </ComboBox>

                    <aleethey:LabelTextBox Grid.Column="2"
                                       LabelText="{DynamicResource LangRes_AccountManagementPage_SearchValueLabel}"
                                       
                                       Text="{Binding Search_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Style="{StaticResource Style_Inside}" />

                    <Button Grid.Column="4"
                            Content="{DynamicResource LangRes_AccountManagementPage_AddAccountBtn}"
                            Command="{Binding AddUser_Command}"
                            Height="29" />

                </Grid>
            </StackPanel>

            <DockPanel Margin="0,10,0,0"
                       LastChildFill="True">

                <aleethey:BlockHeader DockPanel.Dock="Top"
                                  Text="{DynamicResource LangRes_AccountManagementPage_UserListBlockLabel}" />

                <!-- Table -->
                <DataGrid Margin="0,7,0,0"
                          IsSynchronizedWithCurrentItem="True"
                          ItemsSource="{Binding ElementName=Root, Path=DataContext.Users, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                          AutoGenerateColumns="False">

                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding ElementName=Root, Path=DataContext.OpenDialogWindowCommand}"
                                      CommandParameter="{Binding ElementName=Root, Path=DataContext.Users/}" />
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource LangRes_AccountManagementPage_Column_Number}" 
                                            CellStyle="{StaticResource FirstColumnCell}"
                                            Binding="{Binding _id, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True"
                                            Width="0.5*" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_AccountManagementPage_Column_Login}"
                                            Width="*" 
                                            Binding="{Binding _username, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_AccountManagementPage_Column_Surname}"
                                            Width="*"
                                            Binding="{Binding _surname, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_AccountManagementPage_Column_Name}"
                                            Width="*" 
                                            Binding="{Binding _name, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_AccountManagementPage_Column_Lastname}"
                                            Width="*" 
                                            Binding="{Binding _lastname, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_AccountManagementPage_Column_SmenaNumber}"
                                            Width="*" 
                                            Binding="{Binding _smena_number, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_AccountManagementPage_Column_AccessLevel}"
                                            Width="*"
                                            Binding="{Binding Access_Level, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_AccountManagementPage_Column_AccountStatus}"
                                            Width="*"
                                            Binding="{Binding Is_Active, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>

                </DataGrid>
            </DockPanel>
        </DockPanel>

    </Border>

</UserControl>