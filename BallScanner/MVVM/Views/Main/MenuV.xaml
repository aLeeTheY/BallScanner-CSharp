<UserControl x:Class="BallScanner.MVVM.Views.Main.MenuV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:aleethey="clr-namespace:aLeeTheY.Controls;assembly=aLeeTheY.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <sys:Boolean x:Key="IsMinStateForMenu">False</sys:Boolean>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Left"
                   LastChildFill="True"
                   Margin="10,0,10,10"
                   Name="MyMenuContainer"
                   Width="Auto">

            <Viewbox DockPanel.Dock="Top"
                     Child="{StaticResource Vector_Logo}"
                     Margin="12,0,12,8.7" 
                     MaxWidth="180"
                     Name="MyLogo" />

            <aleethey:JustButton DockPanel.Dock="Bottom"
                             Name="MyLogoutButton"
                             Command="{Binding Logout_Command}"
                             Icon="{StaticResource Geometry_Icon_Logout}"
                             IconFill="{DynamicResource Brush_OnBackground_OnSurface_High}"
                             ContentStringFormat="{DynamicResource LangRes_MenuComponent_AccountLogoutBtn}" 
                             IsMinState="{DynamicResource IsMinStateForMenu}" />
            
            <aleethey:JustButton DockPanel.Dock="Bottom"
                             Name="MyCollapseButton"
                             Click="MyCollapseButton_Click"
                             Icon="{StaticResource Geometry_Icon_ExpandLess}"
                             IconFill="{DynamicResource Brush_OnBackground_OnSurface_High}"
                             ContentStringFormat="{DynamicResource LangRes_MenuComponent_CollapseExpandBtn}" 
                             IsMinState="{DynamicResource IsMinStateForMenu}" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <aleethey:BlockHeader Name="MyBlockHeader"
                                  Text="{DynamicResource LangRes_MenuComponent_BlockLabel}"
                                  TextAlignment="Center"
                                  Margin="0,0,0,7" />

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                
                    <StackPanel Orientation="Vertical"
                                Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width, UpdateSourceTrigger=PropertyChanged}">

                        <aleethey:MenuButton Icon="{StaticResource Geometry_Icon_AccountManagment}"
                                         IconFill="{DynamicResource Brush_Primary_Pink}"
                                         ContentStringFormat="{DynamicResource LangRes_MenuComponent_AccountManagmentBtn}"
                                         Command="{Binding MenuButtonClick}"
                                         CommandParameter="AccountManagment" 
                                         Margin="0"
                                         IsMinState="{DynamicResource IsMinStateForMenu}"
                                         Name="AccountManagmentButton"
                                         Visibility="Collapsed"
                                         IsEnabled="False" />
                        
                        <aleethey:MenuButton Icon="{StaticResource Geometry_Icon_Account}"
                                         IconFill="{DynamicResource Brush_Primary_Red}"
                                         ContentStringFormat="{DynamicResource LangRes_MenuComponent_AccountBtn}"
                                         Command="{Binding MenuButtonClick}"
                                         CommandParameter="Account" 
                                         IsMinState="{DynamicResource IsMinStateForMenu}"
                                         Name="AccountButton" />

                        <aleethey:MenuButton Icon="{StaticResource Geometry_Icon_Scan}"
                                         IconFill="{DynamicResource Brush_Primary_Orange}"
                                         ContentStringFormat="{DynamicResource LangRes_MenuComponent_ScanBtn}"
                                         Command="{Binding MenuButtonClick}"
                                         CommandParameter="Scan" 
                                         IsMinState="{DynamicResource IsMinStateForMenu}"
                                         Name="ScanButton" />

                        <aleethey:MenuButton Icon="{StaticResource Geometry_Icon_Calibrate}"
                                         IconFill="{DynamicResource Brush_Primary_Yellow}"
                                         ContentStringFormat="{DynamicResource LangRes_MenuComponent_CalibrateBtn}"
                                         Command="{Binding MenuButtonClick}"
                                         CommandParameter="Calibrate" 
                                         IsMinState="{DynamicResource IsMinStateForMenu}"
                                         Name="CalibrateButton" />

                        <aleethey:MenuButton Icon="{StaticResource Geometry_Icon_Documents}"
                                         IconFill="{DynamicResource Brush_Primary_Green}"
                                         ContentStringFormat="{DynamicResource LangRes_MenuComponent_DocumentsBtn}"
                                         Command="{Binding MenuButtonClick}"
                                         CommandParameter="Documents" 
                                         IsMinState="{DynamicResource IsMinStateForMenu}"
                                         Name="DocumentsButton" />

                        <aleethey:MenuButton Icon="{StaticResource Geometry_Icon_Settings}"
                                         IconFill="{DynamicResource Brush_Primary_Blue}"
                                         ContentStringFormat="{DynamicResource LangRes_MenuComponent_SettingsBtn}"
                                         Command="{Binding MenuButtonClick}"
                                         CommandParameter="Settings" 
                                         IsMinState="{DynamicResource IsMinStateForMenu}"
                                         Name="SettingsButton" />

                        <aleethey:MenuButton Icon="{StaticResource Geometry_Icon_About}"
                                         IconFill="{DynamicResource Brush_Primary_Purple}"
                                         ContentStringFormat="{DynamicResource LangRes_MenuComponent_AboutBtn}"
                                         Command="{Binding MenuButtonClick}"
                                         CommandParameter="About" 
                                         IsMinState="{DynamicResource IsMinStateForMenu}"
                                         Name="AboutButton" />

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
        
        <ContentControl Content="{Binding SelectedPage}" />
    </DockPanel>
</UserControl>
