<UserControl x:Class="BallScanner.MVVM.Views.Main.AboutV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:aleethey="clr-namespace:aLeeTheY.Controls;assembly=aLeeTheY.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border CornerRadius="10,0,0,0"
            Background="{DynamicResource Brush_Surface_Overlay_08dp}">

        <!-- Content -->
        <DockPanel LastChildFill="False"
                   Margin="10">

            <aleethey:BlockHeader DockPanel.Dock="Top"
                              Text="{DynamicResource LangRes_AboutPage_ProgramInfoBlockLabel}" />

            <StackPanel Orientation="Vertical"
                        DockPanel.Dock="Top"
                        Margin="0,7,0,0">

                <TextBlock FontSize="14"
                           Foreground="{StaticResource Brush_OnBackground_OnSurface_High}"
                           Name="Version_Field" />

                <TextBlock FontSize="14"
                           Margin="0,7,0,0"
                           Foreground="{StaticResource Brush_OnBackground_OnSurface_High}"
                           Name="Build_Field" />

            </StackPanel>

            <aleethey:BlockHeader DockPanel.Dock="Top"
                              Margin="0,21,0,0"
                              Text="{DynamicResource LangRes_AboutPage_LicensesBlockLabel}" />

            <TextBlock DockPanel.Dock="Top"
                       Margin="0,7,0,0"
                       Text="{DynamicResource LangRes_AboutPage_ApprovedLicense}" 
                       FontSize="14"
                       Foreground="{StaticResource Brush_OnBackground_OnSurface_High}" />

            <TextBlock DockPanel.Dock="Top"
                       Margin="0,7,0,0"
                       FontSize="14"
                       Foreground="{StaticResource Brush_OnBackground_OnSurface_High}"
                       Text="{DynamicResource LangRes_AboutPage_ProductUser}" />

            <TextBlock DockPanel.Dock="Bottom"
                       TextAlignment="Center"
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Text="{DynamicResource LangRes_AboutPage_Copyright}"
                       FontSize="14"
                       Foreground="{StaticResource Brush_OnBackground_OnSurface_High}" />

        </DockPanel>

    </Border>
    
</UserControl>
