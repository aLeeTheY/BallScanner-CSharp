<UserControl x:Class="BallScanner.MVVM.Views.Main.DocumentsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:aleethey="clr-namespace:aLeeTheY.Controls;assembly=aLeeTheY.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             Name="Root">

    <Border CornerRadius="10,0,0,0"
            Background="{DynamicResource Brush_Surface_Overlay_08dp}">

        <!-- Content -->
        <DockPanel Margin="10"
                   LastChildFill="True">
            
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Vertical">

                <aleethey:BlockHeader Text="{DynamicResource LangRes_DocumentsPage_SearchBlockLabel}" />

                <Grid Margin="0,7,0,0"
                      Height="29">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.25*"
                                          MinWidth="150"
                                          MaxWidth="200" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--<ColumnDefinition Width="7" />
                        <ColumnDefinition Width="0.25*"
                                          MinWidth="150"-->

                    <ComboBox SelectedIndex="{Binding Selected_Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="{DynamicResource LangRes_DocumentsPage_SearchCriteria_Date}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_DocumentsPage_SearchCriteria_Fraction}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_DocumentsPage_SearchCriteria_PartiaNumber}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_DocumentsPage_SearchCriteria_SmenaNumber}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_DocumentsPage_SearchCriteria_Value}" />
                        <ComboBoxItem Content="{DynamicResource LangRes_DocumentsPage_SearchCriteria_Note}" />
                    </ComboBox>

                    <aleethey:LabelTextBox Grid.Column="2"
                                       LabelText="{DynamicResource LangRes_DocumentsPage_SearchValueLabel}"
                                       
                                       Text="{Binding Search_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Style="{StaticResource Style_Inside}" />

                </Grid>
            </StackPanel>

            <DockPanel Margin="0,10,0,0"
                       LastChildFill="True">

                <aleethey:BlockHeader DockPanel.Dock="Top"
                                  Text="{DynamicResource LangRes_DocumentsPage_HistoryBlockLabel}" />

                <!-- Table -->
                <DataGrid Margin="0,7,0,0"
                          IsSynchronizedWithCurrentItem="True"
                          ItemsSource="{Binding ElementName=Root, Path=DataContext.Reports, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                          AutoGenerateColumns="False">

                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding ElementName=Root, Path=DataContext.OpenDialogWindowCommand}"
                                      CommandParameter="{Binding ElementName=Root, Path=DataContext.Reports/}" />
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource LangRes_DocumentsPage_Column_Number}" 
                                            CellStyle="{StaticResource FirstColumnCell}"
                                            Binding="{Binding _id, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True"
                                            Width="0.5*" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_DocumentsPage_Column_Date}"
                                            Width="*" 
                                            Binding="{Binding _date, StringFormat=dd.MM.yyyy, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_DocumentsPage_Column_Fraction}"
                                            Width="*"
                                            Binding="{Binding _fraction, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_DocumentsPage_Column_PartiaNumber}"
                                            Width="*" 
                                            Binding="{Binding _partia_number, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_DocumentsPage_Column_SmenaNumber}"
                                            Width="*" 
                                            Binding="{Binding User._smena_number, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_DocumentsPage_Column_Value}"
                                            Width="*" 
                                            Binding="{Binding _avg_black_pixels_value, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{DynamicResource LangRes_DocumentsPage_Column_Note}"
                                            Width="*"
                                            Binding="{Binding _note, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>

                </DataGrid>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
