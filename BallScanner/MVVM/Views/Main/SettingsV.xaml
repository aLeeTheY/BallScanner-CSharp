<UserControl x:Class="BallScanner.MVVM.Views.Main.SettingsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:BallScanner.MVVM.ViewModels.Main"
             xmlns:aleethey="clr-namespace:aLeeTheY.Controls;assembly=aLeeTheY.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <!-- Default State -->
        <DataTemplate x:Key="DefaultState"
                      DataType="{x:Type vm:SettingsVM}">

            <!-- Content -->
            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Language block -->
                <DockPanel Grid.Column="0"
                       Margin="0,0,5,0"
                       LastChildFill="True">

                    <aleethey:BlockHeader DockPanel.Dock="Top"
                                  Text="{DynamicResource LangRes_SettingsPage_LanguageBlockLabel}" />

                    <StackPanel Orientation="Vertical">

                        <aleethey:SimpleRadioButton Name="Button_LanguageRussian"
                                            Content="{StaticResource LangRes_SettingsPage_Language_Russian_AlwaysOnRussian}"
                                            ContentStringFormat="{DynamicResource LangRes_SettingsPage_Language_Russian}"
                                            Image="{StaticResource Vector_Image_FlagRussia}"
                                            ImageWidth="34"
                                            ImageHeight="21"
                                            Margin="0,7,0,0" 
                                            Click="Button_LanguageRussian_Click" />

                        <aleethey:SimpleRadioButton Name="Button_LanguageEnglish"
                                            Content="{StaticResource LangRes_SettingsPage_Language_English_AlwaysOnEnglish}"
                                            ContentStringFormat="{DynamicResource LangRes_SettingsPage_Language_English}"
                                            Image="{StaticResource Vector_Image_FlagAmerica}"
                                            ImageWidth="34"
                                            ImageHeight="21"
                                            Margin="0,7,0,0"
                                            Click="Button_LanguageEnglish_Click" />

                    </StackPanel>

                </DockPanel>

                <!-- Theme block -->
                <DockPanel Grid.Column="1"
                       Margin="5,0,0,0"
                       LastChildFill="True">

                    <aleethey:BlockHeader DockPanel.Dock="Top"
                                  Text="{DynamicResource LangRes_SettingsPage_ThemeBlockLabel}" />

                    <StackPanel Orientation="Vertical">

                        <aleethey:SimpleRadioButton Name="Button_DarkTheme" 
                                            Content="{DynamicResource LangRes_SettingsPage_Theme_Dark}"
                                            ContentStringFormat=""
                                            Icon="{StaticResource Geometry_Icon_DarkMode}"
                                            IconWidth="22"
                                            IconHeight="22"
                                            Margin="0,7,0,0" 
                                            Click="Button_DarkTheme_Click" />

                        <aleethey:SimpleRadioButton Name="Button_LightTheme"
                                            Content="{DynamicResource LangRes_SettingsPage_Theme_Light}"
                                            ContentStringFormat=""
                                            Icon="{StaticResource Geometry_Icon_LightMode}"
                                            IconWidth="22"
                                            IconHeight="22"
                                            Margin="0,7,0,0" 
                                            Click="Button_LightTheme_Click" />

                    </StackPanel>

                </DockPanel>

            </Grid>

        </DataTemplate>

        <!-- Min State -->
        <DataTemplate x:Key="MinState"
                      DataType="{x:Type vm:SettingsVM}">

            <!-- Content -->
            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Language block -->
                <DockPanel Grid.Row="0"
                       LastChildFill="True">

                    <aleethey:BlockHeader DockPanel.Dock="Top"
                                  Text="{DynamicResource LangRes_SettingsPage_LanguageBlockLabel}" />

                    <StackPanel Orientation="Vertical">

                        <aleethey:SimpleRadioButton Name="Button_LanguageRussian_Min"
                                            Content="{StaticResource LangRes_SettingsPage_Language_Russian_AlwaysOnRussian}"
                                            ContentStringFormat="{DynamicResource LangRes_SettingsPage_Language_Russian}"
                                            Image="{StaticResource Vector_Image_FlagRussia}"
                                            ImageWidth="34"
                                            ImageHeight="21"
                                            Margin="0,7,0,0" 
                                            Click="Button_LanguageRussian_Click" />

                        <aleethey:SimpleRadioButton Name="Button_LanguageEnglish_Min"
                                            Content="{StaticResource LangRes_SettingsPage_Language_English_AlwaysOnEnglish}"
                                            ContentStringFormat="{DynamicResource LangRes_SettingsPage_Language_English}"
                                            Image="{StaticResource Vector_Image_FlagAmerica}"
                                            ImageWidth="34"
                                            ImageHeight="21"
                                            Margin="0,7,0,0"
                                            Click="Button_LanguageEnglish_Click" />

                    </StackPanel>

                </DockPanel>

                <!-- Theme block -->
                <DockPanel Grid.Row="1"
                       Margin="0,21,0,0"
                       LastChildFill="True">

                    <aleethey:BlockHeader DockPanel.Dock="Top"
                                  Text="{DynamicResource LangRes_SettingsPage_ThemeBlockLabel}" />

                    <StackPanel Orientation="Vertical">

                        <aleethey:SimpleRadioButton Name="Button_DarkTheme_Min" 
                                            Content="{DynamicResource LangRes_SettingsPage_Theme_Dark}"
                                            ContentStringFormat=""
                                            Icon="{StaticResource Geometry_Icon_DarkMode}"
                                            IconWidth="22"
                                            IconHeight="22"
                                            Margin="0,7,0,0" 
                                            Click="Button_DarkTheme_Click" />

                        <aleethey:SimpleRadioButton Name="Button_LightTheme_Min"
                                            Content="{DynamicResource LangRes_SettingsPage_Theme_Light}"
                                            ContentStringFormat=""
                                            Icon="{StaticResource Geometry_Icon_LightMode}"
                                            IconWidth="22"
                                            IconHeight="22"
                                            Margin="0,7,0,0" 
                                            Click="Button_LightTheme_Click" />

                    </StackPanel>

                </DockPanel>

            </Grid>

        </DataTemplate>

    </UserControl.Resources>

    <Border CornerRadius="10,0,0,0"
            Background="{DynamicResource Brush_Surface_Overlay_08dp}"
            SizeChanged="Border_SizeChanged">

        <!-- Main Content -->
        <ContentControl x:Name="MyContentControl"
                        ContentTemplate="{StaticResource DefaultState}" />

    </Border>
    
</UserControl>
