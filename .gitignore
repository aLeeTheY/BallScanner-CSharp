# =================================================================
# .gitignore — whitelist style
# Игнорируем ВСЁ по умолчанию, потом явно разрешаем нужное.
# =================================================================

# ! --- 1. Игнорируем абсолютно всё по умолчанию
# ! --------------------------------------------
*

# ! --- 2. Разрешаем спуск по любым папкам (без этого git не увидит файлы внутри)
# ! ----------------------------------------------------------------------------
!*/
!**/

# ! --- 3. Git / solution / build configs
# ! -------------------------------------
!**/.gitignore
!**/.gitattributes
!**/.editorconfig

!**/*.sln
!**/*.csproj
!**/*.props
!**/*.targets

# ! --- 4. C# / WPF source code
# ! ---------------------------
!**/*.cs
!**/*.xaml
!**/*.resx
!**/*.settings
!**/*.config
!**/*.manifest
!**/*.xsd

# ! --- 5. Project assets
# ! ---------------------
# * IMAGES
!**/*.ico
!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.gif
!**/*.svg
!**/*.bmp
!**/*.webp

# * FONTS
!**/*.ttf
!**/*.otf
!**/*.woff
!**/*.woff2
!**/*.eot

# * SIGNING
!**/*.pfx
!**/*.snk

# * DATABASE TEMPLATE
!**/*.sqlite3

# ! --- 6. Installer scripts
# ! ------------------------
!**/*.iss
!**/*.nsi

!**/installer/output/.gitkeep

# ! --- 7. Documentation
# ! --------------------
!**/*.md
!**/*.txt
!**/LICENSE

# ! --- 8. Scripts
# ! --------------
!**/*.ps1
!**/*.bat
!**/*.sh

# ! --- 9. CI/CD
# ! ------------
!**/*.yml
!**/*.yaml
!**/*.json

# =================================================================
# ! --- 10. ТОЧЕЧНЫЕ ИСКЛЮЧЕНИЯ (перебивают whitelist)
# ! --- Всё, что ниже — игнорируется, даже если попадает под маску выше.
# =================================================================

# * VISUAL STUDIO
**/.vs/
**/bin/
**/obj/
**/packages/
**/publish/

**/*.user
**/*.suo
**/*.userosscache
**/*.sln.docstates

# * BUILD ARTIFACTS
**/*.pdb
**/*.dll
**/*.exe

# * LOGS
**/*.log
**/NLog.xsd.tmp

# * INSTALLER OUTPUT
**/installer/output/*.exe

# * OS FILES
**/.DS_Store
**/Thumbs.db
