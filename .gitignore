# ! =================================================================
# ! .gitignore — whitelist style
# ! =================================================================

# ! --- 1. Игнорируем абсолютно всё по умолчанию
# ! --------------------------------------------
*

# ! --- 2. Разрешаем наблюдать за любыми папками
# ! --------------------------------------------
!*/
!**/

# ! --- 3. Разрешаем проверять только конкретные расширения
# ! -------------------------------------------------------
# * Git / solution / build configs
!**/.gitignore
!**/.gitattributes
!**/.editorconfig

!**/*.sln
!**/*.csproj
!**/*.props
!**/*.targets

# * C# / WPF source code
!**/*.cs
!**/*.xaml
!**/*.resx
!**/*.settings
!**/*.config
!**/*.manifest
!**/*.xsd

# * IMAGES
!**/*.ico
!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.gif
!**/*.svg
!**/*.bmp
!**/*.webp

# * FONTS
!**/*.ttf
!**/*.otf
!**/*.woff
!**/*.woff2
!**/*.eot

# * SIGNING | СЕРТИФИКАТЫ ВКЛЮЧЕНЫ В РЕПО СОЗНАТЕЛЬНО, ЧТОБЫ ОБЕСПЕЧИТЬ ВОСПРОИЗВОДИМОСТЬ СБОРКИ
!**/*.pfx

# * DATABASE TEMPLATE
!**/*.sqlite3

# * Installer files
!**/*.iss
!**/*.nsi

!**/installer/external/*.exe
!**/installer/output/.gitkeep

# * Documentation
!**/*.md
!**/*.txt
!**/LICENSE

# * Scripts
!**/*.ps1
!**/*.bat
!**/*.sh

# * CI/CD
!**/*.yml
!**/*.yaml
!**/*.json

# ! --- 4. Папки и подпапки под запретом
# ! ------------------------------------
# * VISUAL STUDIO
**/.vs/
**/bin/
**/obj/
**/packages/
**/publish/

# ! --- 5. Файлы под запретом
# ! -------------------------
# * BUILD ARTIFACTS
**/*.pdb
**/*.dll

# * LOGS
**/*.log
**/NLog.xsd.tmp

# * INSTALLER OUTPUT
**/installer/output/*.exe

# * OS FILES
**/.DS_Store
**/Thumbs.db
